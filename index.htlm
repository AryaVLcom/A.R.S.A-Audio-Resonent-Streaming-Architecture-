<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>A.R.S.A</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

body{
  font-family:'Poppins',sans-serif;
  background:#050816;
  color:white;
  overflow-x:hidden;
}

/* BACKGROUND */

body::before{
  content:"";
  position:fixed;
  inset:0;
  background:
    radial-gradient(circle at top left, rgba(168,85,247,.25), transparent 25%),
    radial-gradient(circle at bottom right, rgba(59,130,246,.25), transparent 25%);
  z-index:-2;
}

body::after{
  content:"";
  position:fixed;
  inset:0;
  background-image:
    linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px);
  background-size:40px 40px;
  mask-image:linear-gradient(to bottom,rgba(0,0,0,.7),transparent);
  z-index:-1;
}

/* NAVBAR */

nav{
  position:sticky;
  top:0;
  z-index:999;
  width:100%;
  padding:18px 5%;
  display:flex;
  justify-content:space-between;
  align-items:center;
  backdrop-filter:blur(20px);
  background:rgba(5,8,22,.45);
  border-bottom:1px solid rgba(255,255,255,.05);
}

.logo-section{
  display:flex;
  align-items:center;
  gap:14px;
}

.logo{
  width:52px;
  height:52px;
  border-radius:16px;
  object-fit:cover;
  box-shadow:
    0 0 25px rgba(168,85,247,.45),
    0 0 40px rgba(59,130,246,.25);
}

.logo-title{
  font-size:1.2rem;
  font-weight:700;
  letter-spacing:1px;
}

.download-btn{
  text-decoration:none;
  color:white;
  background:
    linear-gradient(135deg,#9333ea,#2563eb);
  padding:14px 28px;
  border-radius:18px;
  font-weight:600;
  transition:.3s;
  box-shadow:
    0 10px 35px rgba(147,51,234,.35);
}

.download-btn:hover{
  transform:translateY(-3px);
}

/* HERO */

.hero{
  width:100%;
  padding:45px 5%;
}

.feature-graphic{
  position:relative;
  overflow:hidden;
  border-radius:36px;
  min-height:500px;
  background:
    linear-gradient(135deg,#12071f,#050816);
  border:1px solid rgba(255,255,255,.06);
  box-shadow:
    0 0 60px rgba(0,0,0,.45),
    inset 0 0 80px rgba(255,255,255,.03);
}

/* YOUR FEATURE GRAPHIC IMAGE */

.feature-graphic img{
  width:100%;
  height:100%;
  object-fit:cover;
  position:absolute;
  inset:0;
}

/* OVERLAY */

.overlay{
  position:absolute;
  inset:0;
  background:
    linear-gradient(
      90deg,
      rgba(5,8,22,.95) 0%,
      rgba(5,8,22,.75) 40%,
      rgba(5,8,22,.15) 100%
    );
  display:flex;
  align-items:center;
  padding:60px;
}

.hero-content{
  max-width:550px;
  z-index:2;
}

.tag{
  display:inline-flex;
  align-items:center;
  gap:10px;
  padding:10px 18px;
  border-radius:999px;
  background:rgba(255,255,255,.06);
  border:1px solid rgba(255,255,255,.08);
  color:#d8b4fe;
  margin-bottom:24px;
  backdrop-filter:blur(15px);
}

.hero-title{
  font-size:5rem;
  line-height:1;
  margin-bottom:20px;
  background:
    linear-gradient(90deg,#d8b4fe,#60a5fa);
  -webkit-background-clip:text;
  -webkit-text-fill-color:transparent;
}

.hero-text{
  font-size:1.1rem;
  color:#cbd5e1;
  line-height:1.7;
  margin-bottom:35px;
}

.hero-actions{
  display:flex;
  gap:18px;
  flex-wrap:wrap;
}

.secondary-btn{
  padding:14px 28px;
  border-radius:18px;
  background:rgba(255,255,255,.05);
  border:1px solid rgba(255,255,255,.08);
  color:#e2e8f0;
  backdrop-filter:blur(15px);
}

/* SECTION */

.section{
  padding:50px 5%;
}

.section-title{
  font-size:2rem;
  margin-bottom:28px;
}

/* SCREENSHOTS */

.shots{
  display:flex;
  gap:22px;
  overflow-x:auto;
  padding-bottom:10px;
}

.shots img{
  width:280px;
  border-radius:30px;
  border:1px solid rgba(255,255,255,.08);
  box-shadow:
    0 0 40px rgba(0,0,0,.4);
}

/* INSTALL */

.install-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
  gap:22px;
}

.install-card{
  background:rgba(255,255,255,.04);
  border:1px solid rgba(255,255,255,.06);
  border-radius:28px;
  padding:28px;
  backdrop-filter:blur(20px);
}

.install-number{
  width:45px;
  height:45px;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  background:
    linear-gradient(135deg,#9333ea,#2563eb);
  font-weight:700;
  margin-bottom:18px;
}

.install-card h3{
  margin-bottom:10px;
}

.install-card p{
  color:#cbd5e1;
  line-height:1.6;
}

/* FOOTER */

footer{
  padding:40px;
  text-align:center;
  color:#94a3b8;
  border-top:1px solid rgba(255,255,255,.05);
}

/* MOBILE */

@media(max-width:900px){

  .overlay{
    padding:35px;
  }

  .hero-title{
    font-size:3.5rem;
  }

}

@media(max-width:650px){

  .hero-title{
    font-size:2.8rem;
  }

  .overlay{
    background:
      linear-gradient(
        to top,
        rgba(5,8,22,.96),
        rgba(5,8,22,.55)
      );
    align-items:flex-end;
  }

}

</style>
</head>

<body>

<!-- NAV -->

<nav>

  <div class="logo-section">

    <img
      class="logo"
      src="YOUR_LOGO_URL"
      alt="A.R.S.A Logo"
    >

    <div class="logo-title">
      A.R.S.A
    </div>

  </div>

  <a
    class="download-btn"
    href="https://github.com/AryaVLcom/A.R.S.A-Audio-Resonent-Streaming-Architecture-/releases/download/Release/A.R.S.A.Signed.-1.apk"
  >
    Download APK
  </a>

</nav>

<!-- HERO -->

<section class="hero">

  <div class="feature-graphic">

    <!-- ADD YOUR FEATURE GRAPHIC HERE -->
    <img
      src="YOUR_FEATURE_GRAPHIC_URL"
      alt="A.R.S.A Feature Graphic"
    >

    <div class="overlay">

      <div class="hero-content">

        <div class="tag">
          ✦ Next Generation Music Streaming
        </div>

        <h1 class="hero-title">
          A.R.S.A
        </h1>

        <p class="hero-text">
          Futuristic music streaming with immersive visuals,
          intelligent recommendations, and premium liquid-glass design.
        </p>

        <div class="hero-actions">

          <a
            class="download-btn"
            href="https://github.com/AryaVLcom/A.R.S.A-Audio-Resonent-Streaming-Architecture-/releases/download/Release/A.R.S.A.Signed.-1.apk"
          >
            Install Now
          </a>

          <div class="secondary-btn">
            Android APK
          </div>

        </div>

      </div>

    </div>

  </div>

</section>

<!-- SCREENSHOTS -->

<section class="section">

  <h2 class="section-title">
    App Preview
  </h2>

  <div class="shots">

    <img src="YOUR_SCREENSHOT_1">
    <img src="YOUR_SCREENSHOT_2">
    <img src="YOUR_SCREENSHOT_3">

  </div>

</section>

<!-- INSTALL -->

<section class="section">

  <h2 class="section-title">
    How to Install
  </h2>

  <div class="install-grid">

    <div class="install-card">

      <div class="install-number">1</div>

      <h3>Download APK</h3>

      <p>
        Press the download button to begin downloading the A.R.S.A APK.
      </p>

    </div>

    <div class="install-card">

      <div class="install-number">2</div>

      <h3>Open Downloads</h3>

      <p>
        Open your notification panel or Downloads folder after completion.
      </p>

    </div>

    <div class="install-card">

      <div class="install-number">3</div>

      <h3>Allow Installation</h3>

      <p>
        Enable “Install Unknown Apps” if Android requests permission.
      </p>

    </div>

    <div class="install-card">

      <div class="install-number">4</div>

      <h3>Install & Enjoy</h3>

      <p>
        Open the APK and start streaming inside your cyberpunk music universe.
      </p>

    </div>

  </div>

</section>

<footer>
  © 2026 A.R.S.A Music Engine
</footer>

</body>
</html>
